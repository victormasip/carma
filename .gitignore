# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.gstack/

# Grabber Eval snapshot cache (deterministic replays; refetch with --refresh)
.grabber-cache/

# Grabber Eval / fidelity RUN OUTPUT. The baselines (tests/grabber/baseline.json)
# are committed on purpose — they are the regression reference a --diff compares
# against. The per-run reports are regenerated by every invocation and would be
# nothing but churn in the history.
tests/grabber/report.json
tests/grabber/fidelity.json
